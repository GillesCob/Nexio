{
  "manifest_version": 3,
  "name": "Nexio – Extraction LinkedIn",
  "version": "0.1.0",
  "description": "Copie le texte pertinent d'un profil ou d'une page entreprise LinkedIn, prêt à coller dans Nexio.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://nexio-api.gillescobigo.com/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/school/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
